# Server Control Panel — runtime configuration.
# Copy to .env; the systemd unit loads this file.

# Network
HOST=0.0.0.0
PORT=8088

# Where repositories are cloned and apps are run from
PM2D_PROJECTS_DIR=/home/CHANGEME/projects

# PM2 daemon to manage. Must match the PM2_HOME of the user running apps,
# or the panel will talk to a different daemon than your `pm2` CLI.
PM2_HOME=/home/CHANGEME/.pm2

# Panel data: SQLite database, encryption key, session secret.
# Defaults to <install dir>/data
# PM2D_DATA_DIR=/var/lib/server-control-panel

# Secrets. Generated on first run if unset — set them explicitly to keep
# sessions and stored credentials valid across a reinstall.
# BETTER_AUTH_SECRET=
# PM2D_SECRET_KEY=

# Set true when serving over HTTPS (behind a reverse proxy or tunnel).
PM2D_SECURE_COOKIES=false

# Optional: pin the public URL if the panel sits behind a fixed domain.
# BETTER_AUTH_URL=https://panel.example.com
